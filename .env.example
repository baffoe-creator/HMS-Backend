# Copy this file to .env.development and adjust if needed.
# Never commit real .env files with secrets - only .env.example templates.

NODE_ENV=development
PORT=4000

# MySQL (matches docker-compose.yml defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hms_user
DB_PASSWORD=hms_password
DB_NAME=hms_dev

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Auth (placeholder - generate a real secret before Phase 1)
JWT_SECRET=change_me_in_local_env
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
